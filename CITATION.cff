    given-names: Julien
  - family-names: Chang
    given-names: Joanna
repository-code: "https://github.com/general-sense/xdflow"
url: "https://xdflow.readthedocs.io"
license: MIT
version: "0.3.0"
date-released: "2026-10-09"
keywords:
  - machine learning
  - xarray
  - cross-validation
  - data leakage
  - neuroscience
  - time series
